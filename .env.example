# --- Modelos locales de Hugging Face (sin APIs de IA externas) ---
HF_SCRIPT_MODEL=Qwen/Qwen2.5-3B-Instruct
HF_TTS_MODEL=facebook/mms-tts-spa

# --- YouTube (uso local con navegador) ---
YOUTUBE_CLIENT_SECRETS_FILE=youtube_client_secret.json

# --- YouTube (uso en el Space, sin disco persistente) ---
